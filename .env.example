# Copy this file to .env and fill in the blanks.

# ---- Scoring model ----
# claude (default) or gemini
LLM_PROVIDER=claude
# From console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# low / medium / high - higher is more careful but slower and costs more
CLAUDE_EFFORT=medium
# Only if LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# How many resumes to score at the same time
SCORING_WORKERS=4

# ---- Who the emails come from ----
SENDER_NAME=Arjun
COMPANY_NAME=Kargo
# Optional booking link (Calendly etc). If empty, the invite asks for 3 time slots.
SCHEDULING_LINK=

# ---- Sending email (leave blank to use drafts / "Open in mail app" only) ----
# Option A - Resend (recommended): resend.com -> API Keys. If set, Resend is used instead of SMTP.
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend. Until then, onboarding@resend.dev only
# delivers to your own Resend account email (fine for testing, not for candidates).
RESEND_FROM=onboarding@resend.dev
# Where candidate replies go (e.g. your own inbox)
REPLY_TO=
# Test mode: when set, every email goes to this address instead of the candidate
# (subject says who it was meant for). Leave empty to send to candidates for real.
EMAIL_TEST_TO=
# Option B - SMTP:
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASSWORD=a 16-character App Password (Google Account -> Security -> App passwords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional: a different From address, and a BCC copy of every email for your records
SMTP_FROM=
SMTP_BCC=

# ---- Storage (optional) ----
# Leave blank to keep data in data/candidates.json on this computer.
# Supabase: Project Settings -> API. Run supabase_setup.sql once in the SQL Editor first.
SUPABASE_URL=
# The SECRET key (sb_secret_... or the legacy service_role key). Server-side only - never put it in a web page.
SUPABASE_SECRET_KEY=

# Login password for the dashboard. REQUIRED anywhere other people can reach it (e.g. Vercel).
DASHBOARD_PASSWORD=

PORT=8765
